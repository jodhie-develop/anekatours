{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "profil"}], "destination": "/about", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "product"}], "destination": "/programs", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "contact"}], "destination": "/contact", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "special"}], "destination": "/services", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "irian"}], "destination": "/destinations", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "java"}], "destination": "/destinations/java", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "eastjava"}], "destination": "/destinations/java", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "centraljava"}], "destination": "/destinations/java", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "westjava"}], "destination": "/destinations/java", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "bali"}], "destination": "/destinations/bali", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "nusa"}], "destination": "/destinations/lombok-komodo", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "sumatera"}], "destination": "/destinations/sumatra", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "sulawesi"}], "destination": "/destinations/sulawesi", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal", "value": "kalimantan"}], "destination": "/destinations/kalimantan", "statusCode": 301},
    {"source": "/", "has": [{"type": "query", "key": "hal"}], "destination": "/programs", "statusCode": 301},
    {"source": "/demo/about-us", "destination": "/about", "statusCode": 301},
    {"source": "/demo/contact", "destination": "/contact", "statusCode": 301},
    {"source": "/demo/java-bali-overland", "destination": "/programs/java-to-bali-culture-volcano", "statusCode": 301},
    {"source": "/demo/bali-east-javas-highlight", "destination": "/programs/java-to-bali-culture-volcano", "statusCode": 301},
    {"source": "/demo/nature-landscape", "destination": "/programs/bali-quiet-roads", "statusCode": 301},
    {"source": "/demo/papua", "destination": "/destinations", "statusCode": 301},
    {"source": "/demo/indonesian-cocktails", "destination": "/", "statusCode": 301},
    {"source": "/demo", "destination": "/", "statusCode": 301},
    {"source": "/demo/java", "destination": "/destinations/java", "statusCode": 301},
    {"source": "/demo/bali", "destination": "/destinations/bali", "statusCode": 301},
    {"source": "/demo/sumatra", "destination": "/destinations/sumatra", "statusCode": 301},
    {"source": "/demo/kalimantan", "destination": "/destinations/kalimantan", "statusCode": 301},
    {"source": "/demo/nusa-tenggara", "destination": "/destinations/lombok-komodo", "statusCode": 301},
    {"source": "/destinations/east-java", "destination": "/destinations/java", "statusCode": 301},
    {"source": "/destinations/central-java-yogyakarta", "destination": "/destinations/java", "statusCode": 301},
    {"source": "/destinations/central-java", "destination": "/destinations/java", "statusCode": 301},
    {"source": "/destinations/west-java", "destination": "/destinations/java", "statusCode": 301},
    {"source": "/destinations/java/east-java", "destination": "/destinations/java", "statusCode": 301},
    {"source": "/destinations/java/central-java", "destination": "/destinations/java", "statusCode": 301},
    {"source": "/destinations/java/west-java", "destination": "/destinations/java", "statusCode": 301},
    {"source": "/destinations/lombok-komodo/:oldRegion", "destination": "/destinations/lombok-komodo", "statusCode": 301},
    {"source": "/destinations/sumatra/:oldRegion", "destination": "/destinations/sumatra", "statusCode": 301},
    {"source": "/destinations/sulawesi/:oldRegion", "destination": "/destinations/sulawesi", "statusCode": 301},
    {"source": "/destinations/kalimantan/:oldRegion", "destination": "/destinations/kalimantan", "statusCode": 301},
    {"source": "/demo/:path*", "destination": "/programs", "statusCode": 301}
  ],
  "rewrites": [
    {"source": "/destinations", "destination": "/destinations/index.html"},
    {"source": "/destinations/:region", "destination": "/destinations/:region/index.html"},
    {"source": "/destinations/java/:attraction", "destination": "/destinations/java/:attraction/index.html"},
    {"source": "/destinations/bali/:attraction", "destination": "/destinations/bali/:attraction/index.html"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-XcDM0cNrdGeTa4NU4sV7+Kmv4WVyUd/7WJBVQ2wRr8w=' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; upgrade-insecure-requests"}, {"key": "X-Frame-Options", "value": "DENY"}, {"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}]},
    {"source": "/(.*)", "has": [{"type": "host", "value": "anekatours\\.vercel\\.app"}], "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]}
  ]
}
